# ─────────────────────────────────────────────────────────────────────────────
# Career OS — configuration. Copy to `.env` (already done by setup) and adjust.
# Secrets live ONLY here (never in the frontend, never committed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (used by docker compose and by `npm run dev` on the host) ──────
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_DB=careeros
DB_PORT=5433
# Host-side URL (npm run dev / drizzle-kit). Inside Docker this is overridden automatically.
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros

# ── App ──────────────────────────────────────────────────────────────────────
APP_PORT=3000
# 127.0.0.1 = local only (recommended). 0.0.0.0 exposes the app to your network.
APP_BIND=127.0.0.1
# Public URL (used for links in exports / MCP). Change when deploying on a VPS.
APP_URL=http://localhost:3000
# Extra allowed Host headers, comma separated (anti DNS-rebinding). Your domain in production.
ALLOWED_HOSTS=
# Optional access token. REQUIRED when the app is reachable from the internet.
# When set, the UI asks for it once (cookie) and API/MCP clients send `Authorization: Bearer <token>`.
APP_ACCESS_TOKEN=
TZ=Europe/Paris

# ── Documents library ────────────────────────────────────────────────────────
# Folder on your computer mounted into the container (CVs, letters, transcripts…).
DOCUMENTS_DIR=./documents
MAX_UPLOAD_MB=25

# ── AI ───────────────────────────────────────────────────────────────────────
# claude-code | anthropic | openai | none
#  - claude-code : Claude Code headless. Either:
#       a) inside Docker with a long-lived token: run `claude setup-token` on your PC, paste it below;
#       b) through the host bridge: run `npm run bridge` on your PC (uses your logged-in Claude Code).
#  - anthropic   : Anthropic API key (pay-as-you-go).
#  - openai      : any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, Gemini…).
#  - none        : no in-app AI. Captures wait in the Inbox; ask Claude Code (MCP) to process them.
AI_PROVIDER=claude-code
# Model: alias (opus, sonnet, haiku) for claude-code, full id for the API (default claude-opus-5-5).
AI_MODEL=
# Optional effort for Claude models: low | medium | high | xhigh | max
AI_EFFORT=
# Language used for generated text (summaries, analysis). Extracted facts keep the source language.
AI_OUTPUT_LANGUAGE=fr

# a) Claude Code inside the container (token from `claude setup-token`, Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
# b) Host bridge (npm run bridge). Leave the URL empty to disable.
CLAUDE_BRIDGE_URL=http://host.docker.internal:4319
CLAUDE_BRIDGE_TOKEN=change-me
CLAUDE_BRIDGE_PORT=4319

# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Install the Claude Code CLI in the Docker image (needed for option a)
INSTALL_CLAUDE_CLI=true

# ── Production (VPS, docker-compose.prod.yml) ────────────────────────────────
# Public domain served by Caddy with automatic HTTPS (DNS A/AAAA record → your server).
DOMAIN=

# ── Backups ──────────────────────────────────────────────────────────────────
# Automatic JSON backups to ./backups (hours between backups, 0 = disabled) and how many to keep.
AUTO_BACKUP_HOURS=24
AUTO_BACKUP_KEEP=14
